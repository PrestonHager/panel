APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_THEME=pterodactyl
APP_TIMEZONE=UTC
APP_URL=http://panel.example.com
APP_LOCALE=en
APP_ENVIRONMENT_ONLY=true

# Set to false to manage mail, reCAPTCHA, and panel update upstream settings from Admin → Settings.
# When true, configure those values here or in the container environment instead.
# APP_ENVIRONMENT_ONLY=false

# Panel self-update upstream (used when APP_ENVIRONMENT_ONLY=true, or as defaults before UI overrides).
# For the PrestonHager fork with plugin manager:
# PTERODACTYL_UPDATE_REPOSITORY=PrestonHager/panel
# PTERODACTYL_UPDATE_BRANCH=feat/plugin-manager
# PTERODACTYL_UPDATE_MODE=git
# PTERODACTYL_UPDATE_GIT_REMOTE=origin
# PTERODACTYL_UPDATE_GITHUB_TOKEN=
# PTERODACTYL_UPDATE_RELEASE=
# PTERODACTYL_UPDATE_BACKUP_RETENTION=5
# PTERODACTYL_PLUGIN_HTTP_ALLOWED_HOSTS=api.cloudflare.com

# Required when the panel sits behind nginx, Caddy, or Cloudflare. Use "*" if you
# cannot pin proxy IPs. Without this, HTTPS APP_URL values can cause redirect loops.
# TRUSTED_PROXIES=*

# Comma-separated hosts that may use cookie-based API auth (defaults include APP_URL).
# SANCTUM_STATEFUL_DOMAINS=panel.example.com

LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=panel
DB_USERNAME=pterodactyl
DB_PASSWORD=

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

CACHE_DRIVER=file
QUEUE_CONNECTION=redis
SESSION_DRIVER=file

HASHIDS_SALT=
HASHIDS_LENGTH=8

MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=25
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="Pterodactyl Panel"
# You should set this to your domain to prevent it defaulting to 'localhost', causing
# mail servers such as Gmail to reject your mail.
#
# @see: https://github.com/pterodactyl/panel/pull/3110
# MAIL_EHLO_DOMAIN=panel.example.com
